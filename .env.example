# Copy to .env and fill in. .env is gitignored.

# Shared secret for the HTTP ingest endpoint's X-Device-Token header.
#   openssl rand -hex 24
INGEST_TOKEN=

# Postgres superuser password. Only reachable on loopback and inside the
# compose network, but it should still not be 'postgres' in production.
POSTGRES_PASSWORD=

# MQTT credentials. Two accounts with different rights - see mosquitto/config/acl.
#   plantnode  may only PUBLISH to plants/#   (compiled into the firmware)
#   bridge     may only SUBSCRIBE to plants/# (used by the API process)
MQTT_NODE_PASSWORD=
MQTT_BRIDGE_PASSWORD=

# Host port the dashboard is published on. 8090 locally, 80 on the server.
WEB_PORT=8090

# Loopback port of the second API instance, server-b. WEB_PORT is server-a's.
WEB_PORT_B=8091

# The chaos monkey's fuse, only read when the `chaos` profile is up: it strikes
# every CHAOS_MIN_S-CHAOS_MAX_S seconds and keeps its victim down CHAOS_DOWN_S.
# CHAOS_MIN_S=120
# CHAOS_MAX_S=600
# CHAOS_DOWN_S=20
