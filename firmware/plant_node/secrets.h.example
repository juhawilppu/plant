// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

#define WIFI_SSID       "your-wifi"
#define WIFI_PASSWORD   "your-wifi-password"

// Must match MQTT_NODE_PASSWORD in the server's .env - the "plantnode" account
// may only publish to plants/#, see mosquitto/config/acl.
#define MQTT_NODE_PASSWORD "paste-the-plantnode-password"

// Must match a device_id row in the devices table
#define DEVICE_ID       "plant-01"

// Protects the OTA endpoint on this node from anyone else on the LAN pushing
// firmware to it. Pick anything; it just has to match between flashes.
#define OTA_PASSWORD    "pick-an-ota-password"
