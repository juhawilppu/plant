// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

#define WIFI_SSID       "your-wifi"
#define WIFI_PASSWORD   "your-wifi-password"

// The HTTP fallback endpoint. The node's real path is MQTT over TLS to
// mqtt.juhawilppu.com:8883 - this stays for bring-up and for curl parity until
// the sketch is converted to PubSubClient.
#define SERVER_URL      "https://plant.juhawilppu.com/api/readings"

// Must match INGEST_TOKEN in the server's .env
#define INGEST_TOKEN    "paste-the-openssl-rand-hex-24-value"

// Must match a device_id row in the devices table
#define DEVICE_ID       "plant-01"
